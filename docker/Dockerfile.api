FROM python:3.11-slim-bookworm AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    VSFX_ENV=production

WORKDIR /srv

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ffmpeg \
        curl \
        ca-certificates \
        libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY pyproject.toml alembic.ini ./
COPY app ./app
COPY migrations ./migrations
COPY config ./config
COPY scripts ./scripts
COPY web/dist ./web/dist

RUN useradd --system --uid 10001 --create-home vsfx \
    && mkdir -p /srv/work /srv/weights \
    && chown -R vsfx:vsfx /srv
USER vsfx

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=4s --start-period=20s --retries=5 \
    CMD curl -fsS http://127.0.0.1:8000/api/v1/healthz || exit 1

CMD ["uvicorn", "app.asgi:application", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "*"]
